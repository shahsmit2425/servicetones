# Optional: leave empty when the web app and API share one origin.
# Native builds MUST point to a deployed HTTPS API before mobile:sync.
VITE_API_URL=
PORT=3001
DATABASE_PATH=data/servicetones.sqlite
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,capacitor://localhost,https://localhost
# Optional coturn shared-secret configuration, needed for reliable calls across NAT.
TURN_URL=
TURN_SECRET=
